# ============================================
# Dropshipping Automation Hub - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores

# --- Servidor ---
PORT=3001
NODE_ENV=development
BASE_URL=https://allydigitalpartners.com
FRONTEND_URL=http://localhost:5173

# --- JWT (autenticação local do dashboard) ---
JWT_SECRET=troque-por-uma-chave-segura-aleatoria-de-64-chars
JWT_EXPIRES_IN=7d

# --- Banco de Dados (SQLite via Prisma) ---
DATABASE_URL="file:./dev.db"

# --- AliExpress Open Platform ---
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_ACCESS_TOKEN=
ALIEXPRESS_REDIRECT_URI=https://allydigitalpartners.com/api/auth/aliexpress/callback

# --- Mercado Livre ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://allydigitalpartners.com/api/auth/mercadolivre/callback

# --- Shopee Open Platform ---
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=https://allydigitalpartners.com/api/auth/shopee/callback

# --- Cron Intervals ---
SYNC_PRODUCTS_CRON="0 */1 * * *"
TRACKING_SYNC_CRON="*/30 * * * *"
TOKEN_REFRESH_CRON="0 */4 * * *"

# --- Webhook Secret (para validação) ---
WEBHOOK_SECRET=troque-por-secret-do-webhook
